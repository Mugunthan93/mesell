{
  "info": {
    "_postman_id": "meesell-api-v1-collection",
    "name": "MeeSell API v1",
    "description": "MeeSell API — 30 operations across 25 paths. Run Auth > Login (dev) first to auto-set {{access_token}}. Dev OTP bypass: otp=000000. See backend/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints.",
      "item": [
        {
          "name": "Login (dev)",
          "description": "Run 1-OTP Send then 2-OTP Verify. Verify test script auto-sets {{access_token}}.",
          "item": [
            {
              "name": "1 - OTP Send",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/otp/send",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "otp",
                    "send"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+919876543210\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Send 6-digit OTP to phone (S7.B.1). Rate limit: 3/h per IP."
              },
              "response": []
            },
            {
              "name": "2 - OTP Verify (auto-sets token)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Auto-set {{access_token}} from the verify response.",
                      "// Dev OTP bypass: otp=000000 (DEV_OTP_BYPASS_CODE on backend).",
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    if (body.access_token) {",
                      "        pm.environment.set('access_token', body.access_token);",
                      "        console.log('access_token set (' + body.expires_in + 's)');",
                      "    }",
                      "} else {",
                      "    console.warn('OTP verify failed. Status:', pm.response.code);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/auth/otp/verify",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "otp",
                    "verify"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"000000\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Verify OTP and receive access JWT (S7.B.2). Test script auto-sets {{access_token}}. Dev bypass: otp=000000. Refresh token in HttpOnly Set-Cookie (FE-D5)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Atomically rotate refresh cookie and issue new access JWT (S7.B.3). Reads refresh_token from HttpOnly cookie. Rate limit: 60/h."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revoke refresh cookie server-side (S7.B.4). Idempotent. Returns 204."
          },
          "response": []
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Return authenticated user profile (S7.B.5). Returns user_id, phone, plan, onboarding_complete."
          },
          "response": []
        }
      ]
    },
