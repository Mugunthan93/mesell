# k8s/svc-iam/secrets.yaml.example
# ===========================================================================
# svc-iam — Sub-Plan G (iam extraction), INFRA deliverable I6 (secret half).
#
# TEMPLATE ONLY — DO NOT commit a populated copy (playbook §0; no secret in git).
#
# The svc-iam Secret is named `iam-svc-secrets` in the `dev` namespace. The
# iam-svc-api Deployment consumes it via
# `envFrom: secretRef: { name: iam-svc-secrets }` (see deployment.yaml). The
# NON-secret half of I6 (APP_ENV, JWT_ALGORITHM, the FE-D5 TTLs, the pepper VERSION,
# CORS) lives in the ConfigMap `iam-svc-config` (configmap.yaml) — never put those
# here, never put a secret VALUE in the ConfigMap.
#
# Authority: handoff_msG_infra.md §1 I6 + SUB_PLAN_0G "Code surfaces" (trimmed
# Settings) + MASTER_PLAN §5.D / §5.A (JWT_SECRET ownership/rotation).
#
# ══════════════════════════════════════════════════════════════════════════════
# ── iam-svc IS THE MOST SECRET-RICH SERVICE (it is the auth + payment authority) ──
# ══════════════════════════════════════════════════════════════════════════════
#   UNLIKE the api-light siblings (customer/dashboard carry only DATABASE_URL +
#   VALKEY_URL + JWT_SECRET), iam OWNS:
#     - JWT issuance       → JWT_SECRET (+ JWT_ALGORITHM in the ConfigMap)
#     - the refresh allowlist → REFRESH_TOKEN_PEPPER + REFRESH_TOKEN_PEPPER_PREVIOUS
#                               (dual-pepper, R5/PR #66; VALUES are secret)
#     - OTP send           → MSG91_AUTH_KEY + MSG91_TEMPLATE_ID
#     - the Razorpay webhook → RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET +
#                               RAZORPAY_WEBHOOK_SECRET (HMAC verify)
#     - audit PII hashing  → AUDIT_PII_SALT
#   So iam-svc-secrets is the LARGEST trimmed secret of any service — by necessity,
#   because iam is where login, refresh, OTP, payment-webhook, and audit converge.
#
# ── WHAT svc-iam NEEDS (the complete set) ───────────────────────────────────
#   - DATABASE_URL — role iam_user; search_path pinned to `iam,public` (its owned
#                    `users` table in schema iam + public.audit_events for the §7.I
#                    direct-ORM audit write). See the search_path note below.
#   - VALKEY_URL   — Valkey *** DB 0 *** (NOT a per-service DB index). DB 0 holds the
#                    SHARED OTP keys (`otp:{phone}`) + the FE-D5 refresh allowlist
#                    (`cache:refresh:v{N}:{hmac}`). These keyspaces are LOCKED-VERBATIM
#                    and UNPREFIXED (the frontend + the dual-pepper rotation runbook
#                    depend on the exact shapes — handoff §1 I8; per-service `{svc}:`
#                    prefixing does NOT apply to these). Shared Valkey instance; no
#                    backfill on cutover (the allowlist/OTP state lives in DB 0, not
#                    in the iam pod — handoff §1 I8 / R4).
#   - JWT_SECRET   — *** iam OWNS issuance (HS256). The SAME value is injected into
#                    EVERY other service (so an iam-issued JWT validates LOCALLY
#                    elsewhere — the Risk #5 / G1 invariant; the integration test
#                    asserts cross-service local validation). iam ALSO owns rotation
#                    (§5.A / handoff §2 — see the rotation note below). *** From SM
#                    `jwt-secret` — the EXACT SAME SM secret every sibling reads.
#   - JWT_ALGORITHM → in the ConfigMap (algorithm NAME is non-secret).
#   - REFRESH_TOKEN_PEPPER          — current dual-pepper VALUE (HMAC key for the
#                    allowlist key derivation `cache:refresh:v{N}:{hmac_sha256(token,
#                    pepper)}`). From SM `refresh-token-pepper`.
#   - REFRESH_TOKEN_PEPPER_PREVIOUS — previous dual-pepper VALUE (read-fallback during
#                    a grace window — validate_refresh_allowlist reads vN then vN-1).
#                    During steady state this MAY equal the current pepper OR be a
#                    distinct prior value mid-rotation. From SM (see note) — if no
#                    rotation is in flight, set equal to REFRESH_TOKEN_PEPPER.
#   - MSG91_AUTH_KEY / MSG91_TEMPLATE_ID — OTP send (POST /api/v1/auth/otp/send). From
#                    SM `msg91-auth-key` / `msg91-template-id`. (NOTE: MSG91 keeps its
#                    own IP whitelist — if dev OTP send fails, the dev server IP must be
#                    whitelisted in the MSG91 dashboard; MEMORY operational note.)
#   - RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET — Razorpay API creds. From SM
#                    `razorpay-key-id` / `razorpay-key-secret` (TEST keys in dev).
#   - RAZORPAY_WEBHOOK_SECRET — HMAC secret for verifying the X-Razorpay-Signature on
#                    POST /api/v1/webhooks/razorpay. From SM `razorpay-webhook-secret`.
#   - AUDIT_PII_SALT — salt for hashing PII in audit rows (the §7.I direct-ORM audit
#                    path writes auth.login.success / auth.token.refreshed / auth.logout
#                    to public.audit_events). From SM `audit-pii-salt`.
#
# ── WHAT svc-iam MUST NOT RECEIVE (handoff §1 I6/I7 — NO AI / NO storage) ─────
#   NO GEMINI_API_KEY        (no AI — iam is auth/payment, not generation)
#   NO LANGFUSE_SECRET_KEY / LANGFUSE_PUBLIC_KEY  (no AI tracing)
#   NO GCS_* / GOOGLE_APPLICATION_CREDENTIALS (no storage — iam touches NO GCS at all;
#                            handoff §1 I7 "GCS service account: NONE")
#   NO CELERY_BROKER_URL / CELERY_RESULT_BACKEND  (no Celery — iam has no task;
#                            SUB_PLAN_0G §0.2 "iam has NO tasks.py")
#   NO CACHE_VERSION         (iam does not use the read-through DB-cache version
#                            segment the api-light siblings use; its Valkey use is the
#                            OTP + allowlist keyspaces, not the cached-response layer)
#   This trimming is the §5.D blast-radius win: a compromised iam pod cannot read the
#   Gemini key OR any GCS creds. (It DOES hold MSG91/Razorpay/JWT — unavoidable, iam
#   IS the auth/payment authority; the trim removes only what iam genuinely never uses.)
#
# ── DATABASE_URL — search_path pinned to iam,public (OWNS the `iam` schema) ───
#   Role = iam_user (created by schema-role.sql, I5). iam OWNS the `iam` schema (the
#   `users` table moves there via the backend schema-move migration), so DATABASE_URL
#   pins `?options=-csearch_path%3Diam,public` — its session sees `iam` first (owned
#   `users` table) and `public` (for the cross-schema audit_events INSERT). This is the
#   svc-export/svc-customer pattern (search_path pinned). Host =
#   postgres.dev.svc.cluster.local:5432 (the shared StatefulSet — V1 shares one
#   Postgres; PgBouncer is LIVE on dev (MS-0)). Password = the iam_user password set
#   out-of-band from SM (see I5) — the SAME value used in ALTER ROLE iam_user WITH
#   PASSWORD. URL-encode any +,/,@ in the password with urllib.parse.quote(pw, safe='')
#   (MEMORY 2026-06-09 Redis/PG URL-parsing lesson — base64 passwords break raw).
#
# ── JWT_SECRET ROTATION (handoff §2 / MASTER_PLAN §5.A — iam OWNS it) ─────────
#   iam-svc OWNS the JWT_SECRET rotation. Because verification is LOCAL in every
#   service (no callback to iam), a rotation is a COORDINATED ROLL: rotate the SM
#   `jwt-secret` value → restart iam-svc → restart every other service within the
#   access-token TTL window (OR run a dual-secret grace window analogous to the
#   dual-pepper pattern). The dual-pepper grace window (docs/runbooks/
#   auth-secret-rotation.md §2, PR #46) covers the REFRESH pepper; a parallel
#   dual-JWT-secret grace window is a SEPARATE V1.5 concern (NOT a V1 blocker — dev
#   rotates by restarting all pods). Flagged in the rollback/rotation runbook
#   deliverable; backend (auth-builder) owns any dual-secret read-path code if V1.5
#   needs it.
#
# Populate from GCP Secret Manager (project=project-1f5cbf72-2820-4cdb-949):
#   JWT_SECRET               ← SM `jwt-secret`              (SAME value every service reads)
#   REFRESH_TOKEN_PEPPER     ← SM `refresh-token-pepper`
#   REFRESH_TOKEN_PEPPER_PREVIOUS ← SM `refresh-token-pepper` (or the prior version mid-rotation)
#   MSG91_AUTH_KEY           ← SM `msg91-auth-key`
#   MSG91_TEMPLATE_ID        ← SM `msg91-template-id`
#   RAZORPAY_KEY_ID          ← SM `razorpay-key-id`         (TEST key in dev)
#   RAZORPAY_KEY_SECRET      ← SM `razorpay-key-secret`     (TEST secret in dev)
#   RAZORPAY_WEBHOOK_SECRET  ← SM `razorpay-webhook-secret`
#   AUDIT_PII_SALT           ← SM `audit-pii-salt`
#   iam_user password        ← SM `dev-iam-db-password`  (NEW SM secret — founder to
#                              create at bootstrap; SAME value used in the I5 ALTER ROLE)
#                              ⚠ INTER-LEAD: this is the one new SM secret Sub-Plan G
#                              needs. It is a per-service DB password, NOT a new IAM
#                              grant — within the §4 ceiling. Founder creates the SM
#                              container + version; infra composes it into DATABASE_URL.
#                              (Mirrors svc-export `dev-export-db-password`,
#                              svc-customer `dev-customer-db-password`.)
#   VALKEY password          ← the existing dev Valkey password (SM/dev creds, same
#                              value the monolith uses; shared instance), DB index 0.
# ===========================================================================
apiVersion: v1
kind: Secret
metadata:
  name: iam-svc-secrets
  namespace: dev
type: Opaque
stringData:
  # --- Database (role iam_user; search_path pinned iam,public — OWNS the iam schema) ---
  DATABASE_URL: "postgresql+asyncpg://iam_user:REPLACE-ME@postgres.dev.svc.cluster.local:5432/meesell?options=-csearch_path%3Diam,public"

  # --- Valkey (shared instance; *** DB 0 *** — OTP keys + FE-D5 refresh allowlist,
  #     LOCKED-VERBATIM unprefixed keyspaces; handoff §1 I8) ---
  # NO CELERY_BROKER_URL / CELERY_RESULT_BACKEND — iam has NO Celery (SUB_PLAN_0G §0.2).
  VALKEY_URL: "redis://:REPLACE-ME@valkey.dev.svc.cluster.local:6379/0"

  # --- JWT (iam OWNS issuance; shared HS256 secret from SM jwt-secret — SAME value
  #     every other service vendors for LOCAL verification per G1/A2/D7) ---
  JWT_SECRET: "REPLACE-ME-FROM-SM-jwt-secret"

  # --- Refresh allowlist dual-pepper VALUES (R5/PR #66). The VERSION segment is in the
  #     ConfigMap; these are the secret HMAC keys. ---
  REFRESH_TOKEN_PEPPER: "REPLACE-ME-FROM-SM-refresh-token-pepper"
  REFRESH_TOKEN_PEPPER_PREVIOUS: "REPLACE-ME-FROM-SM-refresh-token-pepper"

  # --- OTP send (MSG91) ---
  MSG91_AUTH_KEY: "REPLACE-ME-FROM-SM-msg91-auth-key"
  MSG91_TEMPLATE_ID: "REPLACE-ME-FROM-SM-msg91-template-id"

  # --- Razorpay (API creds + webhook HMAC) ---
  RAZORPAY_KEY_ID: "REPLACE-ME-FROM-SM-razorpay-key-id"
  RAZORPAY_KEY_SECRET: "REPLACE-ME-FROM-SM-razorpay-key-secret"
  RAZORPAY_WEBHOOK_SECRET: "REPLACE-ME-FROM-SM-razorpay-webhook-secret"

  # --- Audit PII salt (§7.I direct-ORM audit write to public.audit_events) ---
  AUDIT_PII_SALT: "REPLACE-ME-FROM-SM-audit-pii-salt"

  # --- DELIBERATELY ABSENT (handoff §1 I6/I7): GEMINI_API_KEY, LANGFUSE_SECRET_KEY,
  #     LANGFUSE_PUBLIC_KEY, GCS_BUCKET / GCS_PROJECT_ID / GOOGLE_APPLICATION_CREDENTIALS
  #     (no GCS at all), CELERY_BROKER_URL / CELERY_RESULT_BACKEND (no Celery),
  #     CACHE_VERSION (no read-through DB-cache layer). APP_ENV + JWT_ALGORITHM + the
  #     FE-D5 TTLs + REFRESH_TOKEN_PEPPER_VERSION + CORS_* live in the ConfigMap
  #     (iam-svc-config), NOT here (they are non-secret). ---
