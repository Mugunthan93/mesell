# k8s/svc-catalog/secrets.yaml.example
# ===========================================================================
# svc-catalog — Sub-Plan H (catalog extraction, MS-5), INFRA deliverable I7.
#
# TEMPLATE ONLY — DO NOT commit a populated copy (playbook §0 / §10 Secret
# Management Discipline; no secret value in git).
#
# The svc-catalog Secret is named `svc-catalog-secrets` in the `dev` namespace.
# The single svc-catalog Deployment (api, 2 replicas — the LARGEST pool) consumes
# it via `envFrom: secretRef: { name: svc-catalog-secrets }` (see deployment.yaml).
# (There is NO worker — catalog has no Celery task.)
#
# Authority: handoff_msH_infra.md §5 (Secret Manager bindings) + SUB_PLAN_0H (§617
# Secret Manager bindings: JWT_SECRET, GEMINI_API_KEY, LANGFUSE_*) + MASTER_PLAN
# §5.D ("each service has its own trimmed Settings with ONLY the env vars it needs").
# catalog is AI-consuming (autofill) — its secret set mirrors svc-category/svc-image
# (the other AI services): the AI keys live here; the AI non-secret config
# (GEMINI_MODEL, LANGFUSE_PUBLIC_KEY, LANGFUSE_HOST, AI_DAILY_BUDGET_INR) comes from
# the shared meesell-config ConfigMap, NOT this Secret.
#
# ── WHAT svc-catalog NEEDS (and ONLY this — 5 vars) ─────────────────────────
#   - DATABASE_URL          — points at the `catalog` schema (role=catalog_user).
#                             catalog is READ-WRITE (create/patch/autosave/delete
#                             mutate catalogs/products/product_drafts).
#   - VALKEY_URL            — the SHARED Valkey instance. The vendored shared/valkey.py
#                             is DB-AGNOSTIC (it REPLACES the URL's DB path per-factory:
#                             get_valkey_otp→DB 0, get_valkey_cache→DB 3). So this ONE
#                             URL backs BOTH (a) the GLOBAL ai:* budget brake in DB 0
#                             AND (b) catalog's small read-through cache in DB 3.
#   - JWT_SECRET            — LOCAL JWT verification (D7/H2: every service validates
#                             JWT locally via vendored core/auth.py; catalog does NOT
#                             call iam-svc per token). *** SAME secret iam-svc signs
#                             tokens with *** (SM `jwt-secret`) — iam (MS-4) is ALREADY
#                             extracted and binds the SAME JWT_SECRET; that shared
#                             HS256 key is what makes catalog's local validation work
#                             without per-request iam calls (handoff §5).
#   - GEMINI_API_KEY        — *** catalog IS AI-consuming *** — the autofill workload
#                             calls Gemini via vendored ai_ops. From SM `gemini-api-key`
#                             (verified ENABLED v1).
#   - LANGFUSE_SECRET_KEY   — AI tracing; ai_ops traces flow from the vendored
#                             client.py with service="catalog" tag (§5.F). From SM
#                             `langfuse-secret-key` (verified ENABLED v1).
#     (LANGFUSE_PUBLIC_KEY + LANGFUSE_HOST + GEMINI_MODEL + AI_DAILY_BUDGET_INR come
#      from the shared ConfigMap meesell-config — NOT this Secret.)
#   - APP_ENV / CACHE_VERSION / FEATURE_CATALOG_FORM_ENABLED /
#     FEATURE_AI_AUTOFILL_ENABLED / FEATURE_LIVE_PREVIEW_ENABLED come from the
#     dedicated svc-catalog-config ConfigMap (I8), NOT this Secret.
#
# ── WHAT svc-catalog MUST NOT RECEIVE (handoff §5 — the §5.D blast-radius trim) ─
#   NO CELERY_BROKER_URL / CELERY_RESULT_BACKEND (no worker — catalog has no task)
#   NO GCS_* / GOOGLE_APPLICATION_CREDENTIALS (no storage — I6: no GCS, no SA;
#     verified against handoff §5 + SUB_PLAN_0H §596 + spec_msH_backend: 0 GCS refs.
#     The product-image refs catalog stores are GCS URLs WRITTEN by image-svc; the
#     export-snapshot shim returns a JSON envelope, export-svc owns the XLSX/GCS write.)
#   NO MSG91_AUTH_KEY / MSG91_TEMPLATE_ID  (no SMS/OTP — that's iam-svc)
#   NO RAZORPAY_* / RAZORPAY_WEBHOOK_SECRET (no payment — that's iam-svc/billing)
#   NO REFRESH_TOKEN_PEPPER* / AUDIT_PII_SALT  (auth/pii concerns — iam-svc owns;
#     catalog's audit payload is the AI cost ledger + write-route audit rows, no PII)
#   *** EXPLICITLY per the dispatch final-report requirement: NO razorpay, NO msg91. ***
#   This trimming is the §5.D blast-radius win: a compromised svc-catalog pod can read
#   the Gemini key (intrinsic to its autofill workload, accepted scoped exposure) but
#   NONE of the SMS / payment / refresh-pepper / pii / GCS secrets.
#
# ── DATABASE_URL — schema-scoped (MASTER_PLAN §2.D / §2.E) ───────────────────
#   Role = catalog_user (created by schema-role.sql, I5). search_path pins `catalog`
#   first then `public` (so the app sees its own 3 tables — catalogs, products,
#   product_drafts — AND public.audit_events for the AI cost + write-route audit
#   writes). asyncpg passes server options via the URL `options` query param,
#   URL-encoded:
#     ?options=-csearch_path%3Dcatalog,public
#   Host = postgres.dev.svc.cluster.local:5432 (the shared StatefulSet — V1.5 shares
#   one Postgres). The PgBouncer DATABASE_URL flip (to pgbouncer.dev.svc.cluster.local
#   :6432) is a SEPARATE founder-gated step (MS-0, live per #181 — coordinate at
#   deploy; until then dial postgres directly).
#   Password = the catalog_user password set out-of-band from SM (see I5) — the SAME
#   value used in ALTER ROLE catalog_user WITH PASSWORD. URL-encode any +,/,@ in the
#   password with urllib.parse.quote(pw, safe='') (MEMORY 2026-06-09 PG/Redis URL
#   parsing lesson — base64 passwords break URL parsing if embedded raw).
#
# ── VALKEY: ONE URL, TWO DBs (cache DB 3 + GLOBAL budget brake DB 0) ──────────
#   *** svc-catalog's VALKEY_URL MUST hit the SAME Valkey instance as the monolith +
#   the other AI services (category + image) *** so the GLOBAL ₹500/day budget brake
#   stays coordinated. shared/valkey.py is DB-agnostic (_build_url_for_db REPLACES the
#   path per-factory), so this single URL drives:
#     - DB 0 (get_valkey_otp): the UN-prefixed GLOBAL ai:cost:* / ai:budget:* brake
#       keys — these are NOT `catalog:`-prefixed (the documented EXCEPTION to §2.E
#       per-service prefixing — handoff §2 "Valkey budget-keyspace carve-out: infra
#       MUST NOT namespace these"). If they were prefixed the ₹500 cap would split
#       into N independent caps. The un-prefixed-ness is enforced in the vendored
#       ai_ops code, NOT here — infra just provides the shared URL. *** MS-5 is the
#       LAST AI extraction: after catalog, all 3 AI workloads (smart_picker, autofill,
#       watermark) hit this ONE shared keyspace; the MS-5 integration test asserts a
#       3-source reservation moves the SAME counter. Do NOT touch the ai:* keyspace at
#       cutover. ***
#     - DB 3 (get_valkey_cache): catalog's small read-through cache (`catalog:`-prefixed,
#       §2.E). catalog is NOT a heavy cache consumer (its hot path fetch_schema is
#       served by CATEGORY-svc's cache, not its own).
#   Pointed at /0 (the base DB where the GLOBAL brake lives — the load-bearing
#   keyspace for an AI-consuming service); get_valkey_cache() swaps to /3 internally.
#   (Mirrors svc-image/svc-category's /0 convention.)
#
# Populate from GCP Secret Manager (project=project-1f5cbf72-2820-4cdb-949):
#   JWT_SECRET            ← SM `jwt-secret`            (gcloud secrets versions access latest --secret=jwt-secret)
#   GEMINI_API_KEY        ← SM `gemini-api-key`        (verified ENABLED v1)
#   LANGFUSE_SECRET_KEY   ← SM `langfuse-secret-key`   (verified ENABLED v1)
#   catalog_user password ← SM `dev-catalog-db-password` (*** NEW SM secret — founder to
#                            create at bootstrap; SAME value used in I5 ALTER ROLE ***)
#                            ⚠ FOUNDER: this is the ONE new SM secret Sub-Plan H needs.
#                            It is a per-service DB password, NOT a new IAM grant —
#                            within the §4 ceiling. Founder creates the SM container +
#                            version; infra composes it into DATABASE_URL.
#                            (Mirrors dev-export/image/pricing/customer/category/iam-db-password.)
# ===========================================================================
apiVersion: v1
kind: Secret
metadata:
  name: svc-catalog-secrets
  namespace: dev
type: Opaque
stringData:
  # --- Database (schema-scoped to `catalog`, role catalog_user; READ-WRITE) ---
  DATABASE_URL: "postgresql+asyncpg://catalog_user:REPLACE-ME@postgres.dev.svc.cluster.local:5432/meesell?options=-csearch_path%3Dcatalog,public"

  # --- Valkey (SHARED instance; ONE URL → DB 0 GLOBAL brake + DB 3 cache via the
  #     DB-agnostic shared/valkey.py factory). Pointed at /0 (the global brake DB);
  #     get_valkey_cache() swaps to /3 internally. ---
  VALKEY_URL: "redis://:REPLACE-ME@valkey.dev.svc.cluster.local:6379/0"

  # --- JWT (LOCAL verification per D7/H2; the SAME HS256 secret iam-svc signs with,
  #     from SM jwt-secret; iam (MS-4, already extracted) binds the same key) ---
  JWT_SECRET: "REPLACE-ME-FROM-SM-jwt-secret"

  # --- AI (catalog IS AI-consuming — autofill via vendored ai_ops) ---
  GEMINI_API_KEY: "REPLACE-ME-FROM-SM-gemini-api-key"
  LANGFUSE_SECRET_KEY: "REPLACE-ME-FROM-SM-langfuse-secret-key"
  # LANGFUSE_PUBLIC_KEY + LANGFUSE_HOST + GEMINI_MODEL + AI_DAILY_BUDGET_INR come from
  # the shared ConfigMap meesell-config. APP_ENV + CACHE_VERSION + the 3 FEATURE_*
  # flags come from svc-catalog-config (I8).

  # --- DELIBERATELY ABSENT (handoff §5 / dispatch final-report): CELERY_BROKER_URL,
  #     CELERY_RESULT_BACKEND (no worker), GCS_* / GOOGLE_APPLICATION_CREDENTIALS
  #     (I6 — no GCS, no SA), MSG91_AUTH_KEY, MSG91_TEMPLATE_ID, RAZORPAY_KEY_ID,
  #     RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, REFRESH_TOKEN_PEPPER*,
  #     AUDIT_PII_SALT. *** NO razorpay, NO msg91. *** ---
