# k8s/svc-category/secrets.yaml.example
# ===========================================================================
# svc-category — Sub-Plan F (category extraction, MS-4), INFRA deliverable I7.
#
# TEMPLATE ONLY — DO NOT commit a populated copy (playbook §0 / §10 Secret
# Management Discipline; no secret value in git).
#
# The svc-category Secret is named `svc-category-secrets` in the `dev` namespace.
# The single svc-category Deployment (api) consumes it via
# `envFrom: secretRef: { name: svc-category-secrets }` (see deployment.yaml).
# (There is NO worker — category has no Celery task.)
#
# Authority: handoff_msF_infra.md §5 (Secret Manager bindings) + SUB_PLAN_0F (Infra
# table) + MASTER_PLAN §5.D ("each service has its own trimmed Settings with ONLY the
# env vars it needs"). category is AI-consuming + cache-heavy — its secret set
# mirrors svc-image (the other AI service): the AI keys live here; the AI non-secret
# config (GEMINI_MODEL, LANGFUSE_PUBLIC_KEY, LANGFUSE_HOST, AI_DAILY_BUDGET_INR) comes
# from the shared meesell-config ConfigMap, NOT this Secret.
#
# ── WHAT svc-category NEEDS (and ONLY this — 5 vars) ────────────────────────
#   - DATABASE_URL          — points at the `category` schema (role=category_user).
#   - VALKEY_URL            — the SHARED Valkey instance. The vendored shared/valkey.py
#                             is DB-AGNOSTIC (it REPLACES the URL's DB path per-factory:
#                             get_valkey_otp→DB 0, get_valkey_cache→DB 3). So this ONE
#                             URL backs BOTH (a) the GLOBAL ai:* budget brake in DB 0
#                             AND (b) category's read-through cache in DB 3. See I8.
#   - JWT_SECRET            — LOCAL JWT verification (D7/F2: every service validates
#                             JWT locally via vendored core/auth.py; category does NOT
#                             call iam-svc per token). *** SAME secret iam-svc signs
#                             tokens with *** (SM `jwt-secret`) — MS-G (iam) binds the
#                             SAME JWT_SECRET in the SAME wave; that shared HS256 key is
#                             what makes the parallel category+iam extraction safe
#                             (no request-path coupling, handoff §5 / F2).
#   - GEMINI_API_KEY        — *** category IS AI-consuming *** — the smart_picker
#                             workload calls Gemini via vendored ai_ops. From SM
#                             `gemini-api-key` (verified ENABLED v1).
#   - LANGFUSE_SECRET_KEY   — AI tracing; ai_ops traces flow from the vendored
#                             client.py with service="category" tag (§5.F). From SM
#                             `langfuse-secret-key` (verified ENABLED v1).
#     (LANGFUSE_PUBLIC_KEY + LANGFUSE_HOST + GEMINI_MODEL + AI_DAILY_BUDGET_INR come
#      from the shared ConfigMap meesell-config — NOT this Secret.)
#   - APP_ENV / CACHE_VERSION / FEATURE_SMART_PICKER_ENABLED come from the dedicated
#     svc-category-config ConfigMap (I8), NOT this Secret.
#
# ── WHAT svc-category MUST NOT RECEIVE (handoff §5 — the §5.D blast-radius trim) ─
#   NO CELERY_BROKER_URL / CELERY_RESULT_BACKEND (no worker — category has no task)
#   NO GCS_* / GOOGLE_APPLICATION_CREDENTIALS (no storage — I6: no GCS, no SA)
#   NO MSG91_AUTH_KEY / MSG91_TEMPLATE_ID  (no SMS/OTP — that's iam-svc)
#   NO RAZORPAY_* / RAZORPAY_WEBHOOK_SECRET (no payment — that's iam-svc/billing)
#   NO REFRESH_TOKEN_PEPPER* / AUDIT_PII_SALT  (auth/pii concerns — iam-svc owns;
#     category's audit payload is the AI cost ledger, carries no PII)
#   *** EXPLICITLY per the dispatch final-report requirement: NO razorpay, NO msg91. ***
#   This trimming is the §5.D blast-radius win: a compromised svc-category pod can
#   read the Gemini key (intrinsic to its AI workload, accepted scoped exposure) but
#   NONE of the SMS / payment / refresh-pepper / pii secrets.
#
# ── DATABASE_URL — schema-scoped (MASTER_PLAN §2.D / §2.E) ───────────────────
#   Role = category_user (created by schema-role.sql, I5). search_path pins `category`
#   first then `public` (so the app sees its own 4 tables — categories, templates,
#   field_enum_values, field_aliases — AND public.audit_events for the AI cost write).
#   asyncpg passes server options via the URL `options` query param, URL-encoded:
#     ?options=-csearch_path%3Dcategory,public
#   Host = postgres.dev.svc.cluster.local:5432 (the shared StatefulSet — V1.5 shares
#   one Postgres). The PgBouncer DATABASE_URL flip (to pgbouncer.dev.svc.cluster.local
#   :6432) is a SEPARATE founder-gated step (MS-0, live per #181/#192) — coordinate at
#   deploy; until then dial postgres directly.
#   Password = the category_user password set out-of-band from SM (see I5) — the SAME
#   value used in ALTER ROLE category_user WITH PASSWORD. URL-encode any +,/,@ in the
#   password with urllib.parse.quote(pw, safe='') (MEMORY 2026-06-09 PG/Redis URL
#   parsing lesson — base64 passwords break URL parsing if embedded raw).
#
# ── I8 — VALKEY: ONE URL, TWO DBs (cache DB 3 + GLOBAL budget brake DB 0) ─────
#   *** svc-category's VALKEY_URL MUST hit the SAME Valkey instance as the monolith +
#   other AI services *** so the GLOBAL ₹500/day budget brake stays coordinated.
#   shared/valkey.py is DB-agnostic (_build_url_for_db REPLACES the path per-factory),
#   so this single URL drives:
#     - DB 0 (get_valkey_otp): the UN-prefixed GLOBAL ai:cost:* / ai:budget:* brake
#       keys — these are NOT `category:`-prefixed (the documented EXCEPTION to §2.E
#       per-service prefixing — see SUB_PLAN_0F §F3.b/c). If they were prefixed the
#       ₹500 cap would split into N independent caps. The un-prefixed-ness is enforced
#       in the vendored ai_ops code, NOT here — infra just provides the shared URL.
#     - DB 3 (get_valkey_cache): category's read-through cache (category_tree,
#       schema:{id}, field_enum:{id}:{field}, smart_picker:{hash}) — these DO get the
#       `category:` prefix (service-local cache keys, §2.E). This is the "Valkey DB 3
#       cache mount" the handoff §2 requires — provided implicitly via the shared URL
#       + the DB-agnostic factory; the pre-warm (lifespan) populates DB 3.
#   I point VALKEY_URL at /0 (the base DB where the GLOBAL brake lives — the
#   load-bearing keyspace) and the cache factory swaps to /3 internally. (Mirrors
#   svc-image's /0 convention; svc-customer points at /3 because it has no AI brake —
#   either works since the factory rewrites the path, but /0 is clearer for an
#   AI-consuming service whose brake MUST hit DB 0.)
#
# Populate from GCP Secret Manager (project=project-1f5cbf72-2820-4cdb-949):
#   JWT_SECRET            ← SM `jwt-secret`            (gcloud secrets versions access latest --secret=jwt-secret)
#   GEMINI_API_KEY        ← SM `gemini-api-key`        (verified ENABLED v1)
#   LANGFUSE_SECRET_KEY   ← SM `langfuse-secret-key`   (verified ENABLED v1)
#   category_user password ← SM `dev-category-db-password` (NEW SM secret — founder to
#                            create at bootstrap; SAME value used in I5 ALTER ROLE)
#                            ⚠ INTER-LEAD/founder: this is the ONE new SM secret
#                            Sub-Plan F needs. It is a per-service DB password, NOT a
#                            new IAM grant — within the §4 ceiling. Founder creates the
#                            SM container + version; infra composes it into DATABASE_URL.
#                            (Mirrors svc-export's dev-export-db-password, svc-image's
#                            dev-image-db-password, svc-pricing's dev-pricing-db-password,
#                            svc-customer's dev-customer-db-password.)
# ===========================================================================
apiVersion: v1
kind: Secret
metadata:
  name: svc-category-secrets
  namespace: dev
type: Opaque
stringData:
  # --- Database (schema-scoped to `category`, role category_user) ---
  DATABASE_URL: "postgresql+asyncpg://category_user:REPLACE-ME@postgres.dev.svc.cluster.local:5432/meesell?options=-csearch_path%3Dcategory,public"

  # --- Valkey (SHARED instance; ONE URL → DB 0 GLOBAL brake + DB 3 cache via the
  #     DB-agnostic shared/valkey.py factory). Pointed at /0 (the global brake DB);
  #     get_valkey_cache() swaps to /3 internally. ---
  VALKEY_URL: "redis://:REPLACE-ME@valkey.dev.svc.cluster.local:6379/0"

  # --- JWT (LOCAL verification per D7/F2; the SAME HS256 secret iam-svc signs with,
  #     from SM jwt-secret; MS-G binds the same key in the same wave) ---
  JWT_SECRET: "REPLACE-ME-FROM-SM-jwt-secret"

  # --- AI (category IS AI-consuming — smart_picker via vendored ai_ops) ---
  GEMINI_API_KEY: "REPLACE-ME-FROM-SM-gemini-api-key"
  LANGFUSE_SECRET_KEY: "REPLACE-ME-FROM-SM-langfuse-secret-key"
  # LANGFUSE_PUBLIC_KEY + LANGFUSE_HOST + GEMINI_MODEL + AI_DAILY_BUDGET_INR come from
  # the shared ConfigMap meesell-config. APP_ENV + CACHE_VERSION +
  # FEATURE_SMART_PICKER_ENABLED come from svc-category-config (I8).

  # --- DELIBERATELY ABSENT (handoff §5 / dispatch final-report): CELERY_BROKER_URL,
  #     CELERY_RESULT_BACKEND (no worker), GCS_* / GOOGLE_APPLICATION_CREDENTIALS
  #     (I6 — no GCS, no SA), MSG91_AUTH_KEY, MSG91_TEMPLATE_ID, RAZORPAY_KEY_ID,
  #     RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, REFRESH_TOKEN_PEPPER*,
  #     AUDIT_PII_SALT. *** NO razorpay, NO msg91. *** ---
