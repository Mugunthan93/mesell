# Dockerfile.fly — Fly.io deployment entrypoint
#
# Build context = repo root (Fly.io default). Mirrors backend/Dockerfile
# but prefixes all COPY paths with backend/ so the root-context build works.
#
# The CMD here runs the API process. The [processes] section in fly.toml
# overrides it per-process (api -> gunicorn, worker -> celery).

FROM python:3.12-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app/       ./app/
COPY backend/alembic/   ./alembic/
COPY backend/alembic.ini .
COPY backend/scripts/   ./scripts/

EXPOSE 8000

# Default: API server. Overridden per-process by fly.toml [processes].
CMD ["gunicorn", "app.main:app", \
     "-w", "2", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "-b", "0.0.0.0:8000", \
     "--timeout", "120"]
